# O-Leasing — variables de entorno
# Copia este archivo como ".env" y llena los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).
#
# Hoy la app corre localmente y no depende de ninguna de estas variables
# (usa rutas relativas a BASE_DIR y SQLite local). Se dejan preparadas
# para cuando O-Leasing se despliegue en la nube, donde ya no es seguro
# ni suficiente seguir todo en archivos locales.

# Ruta de la carpeta de datos (si se omite, usa ./data junto a la app)
O_LEASING_DATA_DIR=

# Solo aplica si se agrega autenticación multiusuario en la versión web
O_LEASING_ADMIN_PASSWORD=

# Solo si se conecta a una base de datos externa (Postgres/Turso) en vez
# de SQLite local, requerido para desplegar en la nube (ver docs/MEMORIA_TECNICA.md)
DATABASE_URL=
